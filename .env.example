# Copy to .env for local development. Never commit .env.
# Dev-only defaults; production values come from the environment / Vault / SOPS.

# --- PostgreSQL ---
POSTGRES_USER=plantmarket
# Dev-only. In production set a strong value and APP_ENV=prod.
POSTGRES_PASSWORD=plantmarket
POSTGRES_PORT=5432

# --- WireMock ---
WIREMOCK_PORT=8089

# --- MailHog ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# dev | prod. SecretPolicy rejects dev secrets when APP_ENV=prod.
APP_ENV=dev

# --- Services ---
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8090
CATALOG_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
# Dev-only. SecretPolicy rejects this value when APP_ENV=prod.
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
# Webhook timestamps outside this window (seconds) are rejected.
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# How often order-service scans for expired PENDING_PAYMENT reservations.
ORDER_EXPIRY_SCAN_MS=60000

# --- Auth ---
# Dev-only. SecretPolicy rejects this value when APP_ENV=prod.
JWT_SECRET=dev-only-plant-market-jwt-secret-change-me-0123456789
JWT_ISSUER=http://localhost:8090
JWT_ACCESS_TTL=PT10M
JWT_REFRESH_TTL=P7D
# In production set SESSION_COOKIE_NAME=__Host-PM-SESSION and SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_NAME=PM-SESSION
SESSION_COOKIE_SECURE=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_API_URL=http://localhost:8080
# Storefront BFF (server-side): OAuth2 PKCE token exchange and API calls
AUTH_SERVICE_URL=http://localhost:8090
API_URL=http://localhost:8080
COOKIE_SECURE=false

# --- Gateway ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173
# Dev/CI defaults: SSR catalog pages make many requests per minute.
# Production sets 60/10/300 from the environment (see docs/status.md).
RATE_LIMIT_PUBLIC_RPM=2000
RATE_LIMIT_AUTH_RPM=100
RATE_LIMIT_AUTHENTICATED_RPM=300

# MinIO is not part of Phase 0 (ADR-0003). Ports 9100/9101 stay reserved for Phase 3.

# Media uploads (local volume; replace with MinIO/S3 before prod)
MEDIA_ROOT=./data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8081/media
