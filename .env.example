# Copy to .env for local development. Never commit .env.
# Dev-only defaults; production values come from the environment / Vault / SOPS.

# --- PostgreSQL ---
POSTGRES_USER=plantmarket
POSTGRES_PASSWORD=plantmarket
POSTGRES_PORT=5432

# --- WireMock ---
WIREMOCK_PORT=8089

# --- MailHog ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Services ---
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8090
CATALOG_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret

# --- Auth ---
JWT_SECRET=dev-only-plant-market-jwt-secret-change-me-0123456789
JWT_ISSUER=http://localhost:8090
JWT_ACCESS_TTL=PT10M
JWT_REFRESH_TTL=P7D
# In production set SESSION_COOKIE_NAME=__Host-PM-SESSION and SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_NAME=PM-SESSION
SESSION_COOKIE_SECURE=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080

# --- Gateway ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173
RATE_LIMIT_PUBLIC_RPM=60
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_AUTHENTICATED_RPM=300

# MinIO is not part of Phase 0 (ADR-0003). Ports 9100/9101 stay reserved for Phase 3.
